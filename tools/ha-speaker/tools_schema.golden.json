      "description": "Turn or set lights; status reads them.",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "description": "area or light name"
          },
          "action": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "toggle",
              "set",
              "status"
            ]
          },
          "brightness_pct": {
            "type": "number",
            "description": "0-100"
          },
          "brightness_change_pct": {
            "type": "number",
            "description": "-100..100, brighter/dimmer"
          },
          "color": {
            "type": "string",
            "description": "colour word or r,g,b"
          },
          "color_temp": {
            "type": "string",
            "description": "warm, neutral, cool or kelvin"
          }
        },
        "required": [
          "target",
          "action"
        ]
      }
    }
  },
