{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helm",
  "version": "0.6.0",
  "identifier": "app.helm.home",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": {
      "script": "npm run dev -w ui",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build -w ui",
      "cwd": "../.."
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "object-src": "'none'",
        "media-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": false,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../../worker/package.json": "worker/package.json",
      "../../worker/src/": "worker/src/",
      "../../helpers/package.json": "helpers/package.json",
      "../../helpers/usage/src/": "helpers/usage/src/",
      "../../helpers/titles/src/": "helpers/titles/src/",
      "../../helpers/triage/src/": "helpers/triage/src/",
      "../../helpers/autocomplete/src/": "helpers/autocomplete/src/"
    },
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Helm: a desktop workspace for running and supervising AI coding agents.",
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
