{
  "description": "Two retries (the first superseded by the second), then the request fails and the turn ends in error.",
  "steps": [
    {
      "await": {
        "type": "user"
      },
      "as": "p"
    },
    {
      "emit": {
        "type": "system",
        "subtype": "init",
        "session_id": "fake-session",
        "model": "claude-fake",
        "permissionMode": "default",
        "tools": []
      }
    },
    {
      "emit": {
        "type": "system",
        "subtype": "api_retry",
        "attempt": 1,
        "max_retries": 2,
        "retry_delay_ms": 10,
        "error_status": 500,
        "error": "server_error",
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "system",
        "subtype": "api_retry",
        "attempt": 2,
        "max_retries": 2,
        "retry_delay_ms": 10,
        "error_status": 500,
        "error": "server_error",
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "assistant",
        "message": {
          "id": "msg_err",
          "model": "<synthetic>",
          "content": [
            {
              "type": "text",
              "text": "API Error: 500 server_error"
            }
          ]
        },
        "error": "server_error",
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "result",
        "subtype": "success",
        "is_error": true,
        "result": "API Error: 500 server_error",
        "session_id": "fake-session",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 5,
          "cache_read_input_tokens": 2,
          "cache_creation_input_tokens": 1
        },
        "total_cost_usd": 0.001,
        "duration_ms": 12,
        "num_turns": 1
      }
    }
  ]
}
