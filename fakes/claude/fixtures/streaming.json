{
  "description": "One turn: thinking and text streamed as partial messages, then the whole message, then the result.",
  "steps": [
    {
      "await": {
        "type": "user"
      },
      "as": "p"
    },
    {
      "emit": {
        "type": "system",
        "subtype": "init",
        "session_id": "fake-session",
        "model": "claude-fake",
        "permissionMode": "default",
        "tools": []
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_start",
          "message": {
            "id": "msg_1",
            "model": "claude-fake",
            "content": [],
            "usage": {
              "input_tokens": 10,
              "output_tokens": 1,
              "cache_read_input_tokens": 2,
              "cache_creation_input_tokens": 1
            }
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_start",
          "index": 0,
          "content_block": {
            "type": "thinking",
            "thinking": ""
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_delta",
          "index": 0,
          "delta": {
            "type": "thinking_delta",
            "thinking": "Pondering"
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_stop",
          "index": 0
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_start",
          "index": 1,
          "content_block": {
            "type": "text",
            "text": ""
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_delta",
          "index": 1,
          "delta": {
            "type": "text_delta",
            "text": "Hello "
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_delta",
          "index": 1,
          "delta": {
            "type": "text_delta",
            "text": "world"
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_stop",
          "index": 1
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_delta",
          "delta": {
            "stop_reason": "end_turn"
          },
          "usage": {
            "output_tokens": 5
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_stop"
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "assistant",
        "message": {
          "id": "msg_1",
          "model": "claude-fake",
          "content": [
            {
              "type": "thinking",
              "thinking": "Pondering"
            },
            {
              "type": "text",
              "text": "Hello world"
            }
          ]
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "result",
        "subtype": "success",
        "is_error": false,
        "result": "done",
        "session_id": "fake-session",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 5,
          "cache_read_input_tokens": 2,
          "cache_creation_input_tokens": 1
        },
        "total_cost_usd": 0.001,
        "modelUsage": {
          "claude-fake": {
            "inputTokens": 30,
            "outputTokens": 15,
            "cacheReadInputTokens": 6,
            "cacheCreationInputTokens": 3,
            "costUSD": 0.001
          }
        },
        "duration_ms": 12,
        "num_turns": 1
      }
    }
  ]
}
