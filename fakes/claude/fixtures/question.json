{
  "description": "AskUserQuestion with two questions, answered one step at a time.",
  "steps": [
    {
      "await": {
        "type": "user"
      },
      "as": "p"
    },
    {
      "emit": {
        "type": "system",
        "subtype": "init",
        "session_id": "fake-session",
        "model": "claude-fake",
        "permissionMode": "default",
        "tools": []
      }
    },
    {
      "emit": {
        "type": "control_request",
        "request_id": "q-1",
        "request": {
          "subtype": "can_use_tool",
          "tool_name": "AskUserQuestion",
          "input": {
            "questions": [
              {
                "question": "Which colour?",
                "header": "Colour",
                "options": [
                  {
                    "label": "Red",
                    "description": "warm"
                  },
                  {
                    "label": "Blue",
                    "description": "cool"
                  }
                ],
                "multiSelect": false
              },
              {
                "question": "Which size?",
                "header": "Size",
                "options": [
                  {
                    "label": "Small"
                  },
                  {
                    "label": "Large"
                  }
                ],
                "multiSelect": false
              }
            ]
          },
          "tool_use_id": "tu_1"
        }
      }
    },
    {
      "await": {
        "type": "control_response",
        "response": {
          "request_id": "q-1"
        }
      },
      "as": "ans"
    },
    {
      "emit": {
        "type": "result",
        "subtype": "success",
        "is_error": false,
        "result": "done",
        "session_id": "fake-session",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 5,
          "cache_read_input_tokens": 2,
          "cache_creation_input_tokens": 1
        },
        "total_cost_usd": 0.001,
        "duration_ms": 12,
        "num_turns": 1
      }
    }
  ]
}
