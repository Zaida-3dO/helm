{
  "description": "An approval whose details are over 64 KiB: only Deny and Stop turn may be offered.",
  "steps": [
    {
      "await": {
        "type": "user"
      },
      "as": "p"
    },
    {
      "emit": {
        "type": "system",
        "subtype": "init",
        "session_id": "fake-session",
        "model": "claude-fake",
        "permissionMode": "default",
        "tools": []
      }
    },
    {
      "emit": {
        "type": "control_request",
        "request_id": "perm-big",
        "request": {
          "subtype": "can_use_tool",
          "tool_name": "Write",
          "input": {
            "file_path": "big.txt",
            "content": "{{repeat:x:70000}}"
          },
          "tool_use_id": "tu_1"
        }
      }
    },
    {
      "await": {
        "type": "control_response",
        "response": {
          "request_id": "perm-big"
        }
      },
      "as": "ans"
    },
    {
      "emit": {
        "type": "result",
        "subtype": "success",
        "is_error": false,
        "result": "done",
        "session_id": "fake-session",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 5,
          "cache_read_input_tokens": 2,
          "cache_creation_input_tokens": 1
        },
        "total_cost_usd": 0.001,
        "duration_ms": 12,
        "num_turns": 1
      }
    }
  ]
}
