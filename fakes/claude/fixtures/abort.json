{
  "description": "A streaming turn interrupted by the worker; the CLI settles with an error-labelled result.",
  "steps": [
    {
      "await": {
        "type": "user"
      },
      "as": "p"
    },
    {
      "emit": {
        "type": "system",
        "subtype": "init",
        "session_id": "fake-session",
        "model": "claude-fake",
        "permissionMode": "default",
        "tools": []
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_start",
          "message": {
            "id": "msg_a",
            "model": "claude-fake",
            "content": []
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_start",
          "index": 0,
          "content_block": {
            "type": "text",
            "text": ""
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_delta",
          "index": 0,
          "delta": {
            "type": "text_delta",
            "text": "Working on it"
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "await": {
        "type": "control_request",
        "request": {
          "subtype": "interrupt"
        }
      },
      "timeoutMs": 20000
    },
    {
      "emit": {
        "type": "result",
        "subtype": "error_during_execution",
        "is_error": true,
        "result": "",
        "session_id": "fake-session",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 5,
          "cache_read_input_tokens": 2,
          "cache_creation_input_tokens": 1
        },
        "total_cost_usd": 0.001,
        "duration_ms": 12,
        "num_turns": 1
      }
    }
  ]
}
