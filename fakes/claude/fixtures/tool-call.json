{
  "description": "A tool call streamed with argument deltas, its result, then a final answer.",
  "steps": [
    {
      "await": {
        "type": "user"
      },
      "as": "p"
    },
    {
      "emit": {
        "type": "system",
        "subtype": "init",
        "session_id": "fake-session",
        "model": "claude-fake",
        "permissionMode": "default",
        "tools": []
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_start",
          "message": {
            "id": "msg_t",
            "model": "claude-fake",
            "content": []
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_start",
          "index": 0,
          "content_block": {
            "type": "tool_use",
            "id": "tu_1",
            "name": "Read",
            "input": {}
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_delta",
          "index": 0,
          "delta": {
            "type": "input_json_delta",
            "partial_json": "{\"file_path\":"
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_delta",
          "index": 0,
          "delta": {
            "type": "input_json_delta",
            "partial_json": "\"a.txt\"}"
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_stop",
          "index": 0
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_delta",
          "delta": {
            "stop_reason": "tool_use"
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_stop"
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "assistant",
        "message": {
          "id": "msg_t",
          "model": "claude-fake",
          "content": [
            {
              "type": "tool_use",
              "id": "tu_1",
              "name": "Read",
              "input": {
                "file_path": "a.txt"
              }
            }
          ]
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "user",
        "message": {
          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "tu_1",
              "content": [
                {
                  "type": "text",
                  "text": "file contents"
                }
              ],
              "is_error": false
            }
          ]
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "assistant",
        "message": {
          "id": "msg_sub",
          "content": [
            {
              "type": "text",
              "text": "subagent chatter"
            }
          ]
        },
        "parent_tool_use_id": "tu_1",
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_start",
          "message": {
            "id": "msg_f",
            "model": "claude-fake",
            "content": []
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_start",
          "index": 0,
          "content_block": {
            "type": "text",
            "text": ""
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_delta",
          "index": 0,
          "delta": {
            "type": "text_delta",
            "text": "It says "
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_delta",
          "index": 0,
          "delta": {
            "type": "text_delta",
            "text": "file contents"
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "content_block_stop",
          "index": 0
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_delta",
          "delta": {
            "stop_reason": "end_turn"
          },
          "usage": {
            "output_tokens": 5
          }
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "stream_event",
        "event": {
          "type": "message_stop"
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "assistant",
        "message": {
          "id": "msg_f",
          "model": "claude-fake",
          "content": [
            {
              "type": "text",
              "text": "It says file contents"
            }
          ]
        },
        "parent_tool_use_id": null,
        "session_id": "fake-session"
      }
    },
    {
      "emit": {
        "type": "result",
        "subtype": "success",
        "is_error": false,
        "result": "done",
        "session_id": "fake-session",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 5,
          "cache_read_input_tokens": 2,
          "cache_creation_input_tokens": 1
        },
        "total_cost_usd": 0.001,
        "duration_ms": 12,
        "num_turns": 1
      }
    }
  ]
}
