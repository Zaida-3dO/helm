{
  "name": "helm",
  "private": true,
  "version": "0.2.1",
  "description": "Helm: npm workspaces for the renderer, worker, helpers, fakes and checks.",
  "workspaces": [
    "ui",
    "worker",
    "fakes",
    "helpers",
    "checks"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build:debug": "tauri build --debug --no-bundle",
    "build:installer": "tauri build --bundles nsis",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  }
}
