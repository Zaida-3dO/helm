{
  "name": "@helm/checks",
  "version": "0.0.0",
  "private": true,
  "description": "Helm checks: the end-to-end check drives the debug app over WebView2's DevTools protocol with Playwright. It is not part of `npm test`; run it with `npm run e2e -w checks`.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "e2e": "node --test --test-concurrency=1 \"e2e/*.e2e.ts\"",
    "live": "node --test --test-concurrency=1 \"e2e/*.live.ts\"",
    "perf": "node perf/bench.ts",
    "voice-bench": "node voice-bench/run.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
