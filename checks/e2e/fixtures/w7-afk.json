{
  "description": "AFK and the usage governor: answers the plan-usage control request (5-hour 30%, weekly 56%) and echoes every prompt, so a digest sent to a chat shows up as a turn.",
  "usage": {
    "subscription_type": "max",
    "rate_limits_available": true,
    "rate_limits": {
      "five_hour": { "utilization": 30, "resets_at": "2099-01-01T04:00:00+00:00" },
      "seven_day": { "utilization": 56, "resets_at": "2099-01-03T12:00:00+00:00" },
      "model_scoped": []
    }
  },
  "steps": [
    {
      "repeat": [
        { "await": { "type": "user" }, "as": "p", "timeoutMs": 600000 },
        { "init": { "tools": [] } },
        { "text": "You said: {{p.message.content.0.text}}" },
        { "result": "done" }
      ]
    }
  ]
}
